# ==============================================================================
# PoultryDex API Environment Configuration
# ==============================================================================

# Server Environment (development | production)
NODE_ENV=production

# Server Port (Used for local development; Vercel sets this automatically)
PORT=4000

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas cluster URI:
# Example: mongodb+srv://<db_user>:<db_password>@cluster0.abcde.mongodb.net/poultry_ops?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/poultry_ops?retryWrites=true&w=majority

# JWT Authentication Secret
# Provide a long, random secret key for signing and verifying JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
