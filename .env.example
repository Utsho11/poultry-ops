# ==============================================================================
# PoultryDex Mobile (Expo) Environment Configuration
# ==============================================================================

# Backend API Endpoint URL
# When deployed on Vercel: set to your Vercel deployment URL with /api suffix
# Example: EXPO_PUBLIC_API_URL=https://your-api-project.vercel.app/api

# For local development, comment this out or leave empty to auto-detect your local IP:
# EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_API_URL=
